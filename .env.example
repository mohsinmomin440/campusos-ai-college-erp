# Browser-safe Firebase Web App Configuration ONLY.
# NEVER put Gemini API keys, Firebase Admin SDK service accounts, or payment secrets here.
# VITE_* variables are bundled into client-side JavaScript.

VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-campusos.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-campusos
VITE_FIREBASE_STORAGE_BUCKET=demo-campusos.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:demoappid

# Set to "true" to connect the frontend to the local Firebase Emulator Suite
VITE_USE_FIREBASE_EMULATORS=true

# Optional emulator host override (defaults to 127.0.0.1)
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1

# Optional payment gateway public publishable indicator (leave empty if unconfigured)
VITE_PAYMENT_GATEWAY_PROVIDER=

# Optional external serverless API base URL (e.g. https://campusos-erp.vercel.app/api)
VITE_API_BASE_URL=
