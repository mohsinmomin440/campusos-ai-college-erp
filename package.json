{
  "name": "campusos",
  "private": true,
  "version": "1.0.0",
  "description": "CampusOS — AI-Powered College Management System (Web Only)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run tests/unit",
    "test:watch": "vitest tests/unit",
    "test:rules": "firebase emulators:exec --project demo-campusos --only firestore,storage \"vitest run tests/rules\"",
    "test:functions": "npm --prefix functions test",
    "test:e2e": "playwright test",
    "emulators": "firebase emulators:start",
    "seed:emulator": "node scripts/seed-emulator.js"
  },
  "dependencies": {
    "@google/genai": "^0.14.0",
    "@hookform/resolvers": "^5.0.1",
    "@tanstack/react-query": "^5.74.3",
    "clsx": "^2.1.1",
    "firebase": "^11.6.1",
    "firebase-admin": "^13.2.0",
    "lucide-react": "^0.503.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.56.1",
    "react-router-dom": "^7.5.2",
    "recharts": "^2.15.3",
    "tailwind-merge": "^3.2.0",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/vite": "^4.1.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.4",
    "vitest": "^3.1.2"
  }
}
